add_executable(tinylsm_bench bench/main.cpp)
target_link_libraries(tinylsm_bench PRIVATE tinylsm)
add_executable(tinylsm_rigorous bench/rigorous.cpp)
target_link_libraries(tinylsm_rigorous PRIVATE tinylsm)
target_compile_options(tinylsm_rigorous PRIVATE -Wall -Wextra)
add_executable(tinylsm_crash_acceptance tests/crash_acceptance.cpp)
target_link_libraries(tinylsm_crash_acceptance PRIVATE tinylsm)
